# Absolute path to a prepared Gentoo Git snapshot containing the selected commit and md5-cache blobs.
GENTOO_UPDATE_INTELLIGENCE_SNAPSHOT_PATH=/absolute/path/to/gentoo-snapshot
GENTOO_UPDATE_INTELLIGENCE_REPOSITORY=gentoo
GENTOO_UPDATE_INTELLIGENCE_SOURCE_URL=https://github.com/gentoo-mirror/gentoo
GENTOO_UPDATE_INTELLIGENCE_COMMIT=replace-with-full-40-character-commit-sha

# Use URL-safe characters because this value is embedded in the local PostgreSQL URL.
POSTGRES_PASSWORD=change-me

# Optional host port; frontend binds to 127.0.0.1 only.
FRONTEND_PORT=8081
