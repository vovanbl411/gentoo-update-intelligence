# Use URL-safe characters because this value is embedded in the local PostgreSQL URL.
POSTGRES_PASSWORD=change-me

# Optional host port; frontend binds to 127.0.0.1 only.
FRONTEND_PORT=8081

# Optional Gentoo Git source; the gentoo service synchronizes it automatically.
# GENTOO_REPOSITORY_URL=https://anongit.gentoo.org/git/repo/gentoo.git

# Optional maximum number of concurrent egencache runs (default: 2).
# METADATA_WORKER_GENERATION_LIMIT=2
