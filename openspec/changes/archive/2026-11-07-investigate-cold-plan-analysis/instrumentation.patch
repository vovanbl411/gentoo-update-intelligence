--- /dev/null
+++ b/backend/internal/coldtrace/trace.go
@@ -0,0 +1,36 @@
+// Package coldtrace is used only by the isolated measurement build.
+package coldtrace
+
+import (
+	"encoding/json"
+	"os"
+	"sync"
+	"sync/atomic"
+	"time"
+)
+
+var epoch = time.Now()
+var sequence atomic.Uint64
+var mu sync.Mutex
+
+func emit(id uint64, stage, key, event string, elapsed int64) {
+	b, _ := json.Marshal(struct {
+		ID       uint64 `json:"id"`
+		Stage    string `json:"stage"`
+		Key      string `json:"key"`
+		Event    string `json:"event"`
+		Mono     int64  `json:"mono_ns"`
+		Wall     int64  `json:"wall_ns"`
+		Duration int64  `json:"duration_ns"`
+	}{id, stage, key, event, time.Since(epoch).Nanoseconds(), time.Now().UnixNano(), elapsed})
+	mu.Lock()
+	defer mu.Unlock()
+	os.Stderr.Write(append(append([]byte("COLDTRACE "), b...), '\n'))
+}
+func Start(stage, key string) func() {
+	id := sequence.Add(1)
+	start := time.Now()
+	emit(id, stage, key, "start", 0)
+	var once sync.Once
+	return func() { once.Do(func() { emit(id, stage, key, "end", time.Since(start).Nanoseconds()) }) }
+}
